# Capture config, checked in. Credentials live in screenshots/.env.
# No quotes, no inline comments (docker keeps everything after = literally).

# Console to capture against. No trailing slash.
CONSOLE_URL=https://cloud-orchestrator.public.eu-1.ndskuue5.stakater.cloud

# Organisation slug typed on the sign-in screen.
CONSOLE_ORG=acme

# login, resources: sidebar group clicked to reveal its All/Create entries.
# Must match the label exactly as the sidebar renders it.
DOCS_SIDEBAR_GROUP=Virtual Machines

# resources: route segment for the resource used throughout resources.md.
# This is the plural from the OpenAPI spec, not the sidebar label.
DOCS_VM_PLURAL=virtualmachines

# resources: the row opened for the detail, delete-panel and Advanced shots.
# Must exist, and the same one is used for all three so they agree.
DOCS_VM_NAME=demo-virtual-machine

# projects: route segment for the Projects pages.
DOCS_PROJECT_PLURAL=projects

# Every DOCS_*_SIDEBAR_GROUP below is a RESOURCE entry in the sidebar -- the collapsible
# one, which opens to All/Create. It is not the heading above it ("Identity & Access",
# "Networking", "Containers"): those are static section labels and clicking one does
# nothing. The label is the resource kind humanised and pluralised by the console, so
# OpenShiftCluster reads "Open Shift Clusters", with the space.

# iam: the Users entry, and the route segments for Users and Groups.
DOCS_USER_SIDEBAR_GROUP=Users
DOCS_USER_PLURAL=users
DOCS_GROUP_PLURAL=groups

# iam: the group opened for the detail shot. Must exist in CONSOLE_ORG, and must have
# members -- the point of that image is what a populated group looks like, and an empty
# one publishes a screenshot that contradicts the page around it.
# Named to match the example in create-iam-group.md, so the image and the snippet
# describe one group. Its members are alice, bob and charlie there, and those have to
# exist as users first, which is also what puts rows in the Users list this flow shoots.
DOCS_GROUP_NAME=engineering-team

# iam: label of the members array field, as the console renders it. It comes from the
# OpenAPI spec, not from us, so it moves when the IAM API version moves.
DOCS_GROUP_MEMBERS_LABEL=Members

# mesh: sidebar entry and route segment.
DOCS_MESH_SIDEBAR_GROUP=Meshes
DOCS_MESH_PLURAL=meshes

# mesh: the mesh opened for the detail shot. Must exist in CONSOLE_ORG. Named to match
# the example in create-mesh.md.
DOCS_MESH_NAME=my-mesh

# clusters: route segment. No sidebar entry or cluster name here, because the flow only
# captures the create form -- see the note at the top of flows/clusters.yaml.
DOCS_CLUSTER_PLURAL=openshiftclusters
